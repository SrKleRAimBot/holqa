{
  "name": "@holqa/cli",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "The Holqa command-line interface: inspect, build --manifest, dev (local development supervisor), invoke, queue send, storage put, cron run, state and doctor.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SrKleRAimBot/holqa.git",
    "directory": "packages/cli"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "holqa": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@holqa/bindings": "workspace:*",
    "@holqa/compiler": "workspace:*",
    "@holqa/container": "workspace:*",
    "@holqa/core": "workspace:*",
    "@holqa/local": "workspace:*",
    "@holqa/opentelemetry": "workspace:*",
    "@holqa/runtime-bun": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
