{
  "name": "@holqa/testing",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Testing utilities for Holqa applications: createTestApp for deterministic integration tests on the local environment (virtual clock, event flushing, failure injection), and compile-time type assertions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SrKleRAimBot/holqa.git",
    "directory": "packages/testing"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@holqa/core": "workspace:*",
    "@holqa/local": "workspace:*",
    "@holqa/runtime-bun": "workspace:*",
    "@holqa/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
