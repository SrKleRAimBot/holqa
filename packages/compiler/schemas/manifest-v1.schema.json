          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "resource",
        "options"
      ],
      "type": "object"
    },
    "trigger-queue-message": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "queue.message"
        },
        "options": {
          "additionalProperties": false,
          "properties": {
            "concurrency": {
              "$ref": "#/$defs/positiveInteger"
            }
          },
          "required": [],
          "type": "object"
        },
        "resource": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "queue"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "resource",
        "options"
      ],
      "type": "object"
    },
    "trigger-schedule-tick": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "schedule.tick"
        },
        "options": {
          "additionalProperties": false,
          "properties": {},
          "required": [],
          "type": "object"
        },
        "resource": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "schedule"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "resource",
        "options"
      ],
      "type": "object"
    }
  },
  "$id": "urn:holqa:schema:manifest:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "config": {
      "items": {
        "$ref": "#/$defs/configEntry"
      },
      "type": "array"
    },
    "extensions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "version": {
            "$ref": "#/$defs/positiveInteger"
          }
        },
        "required": [
          "id",
          "version",
          "required"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "handlers": {
      "items": {
        "$ref": "#/$defs/handler"
      },
      "type": "array"
    },
    "manifestVersion": {
      "const": 1
    },
    "requiredCapabilities": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/resource"
      },
      "type": "array"
    },
    "runtime": {
      "enum": [
        "bun"
      ]
    },
    "schemas": {
      "additionalProperties": {
        "$ref": "#/$defs/schemaContract"
      },
      "propertyNames": {
        "$ref": "#/$defs/fingerprint"
      },
      "type": "object"
    }
  },
  "required": [
    "manifestVersion",
    "application",
    "runtime",
    "resources",
    "handlers",
    "config",
    "requiredCapabilities",
    "schemas"
  ],
  "title": "Holqa application manifest, version 1",
  "type": "object"
}
