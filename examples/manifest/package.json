{
  "name": "@holqa/example-manifest",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end compiler example: applications written with @holqa/sdk and Zod, inspected and compiled into manifests by the built holqa CLI.",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test"
  },
  "dependencies": {
    "@holqa/cli": "workspace:*",
    "@holqa/compiler": "workspace:*",
    "@holqa/core": "workspace:*",
    "@holqa/sdk": "workspace:*",
    "@holqa/zod": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
