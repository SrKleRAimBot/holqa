{
  "name": "@holqa/example-http-api",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end runtime example: an SDK application with HTTP routes, RPC procedures and typed middleware, compiled by the built holqa CLI and served by @holqa/runtime-bun.",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "start": "holqa build --manifest --app app/infra.ts && bun app/server.ts"
  },
  "dependencies": {
    "@holqa/cli": "workspace:*",
    "@holqa/core": "workspace:*",
    "@holqa/runtime-bun": "workspace:*",
    "@holqa/sdk": "workspace:*",
    "@holqa/zod": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
