    "@holqa/sdk": "workspace:*",
    "@holqa/zod": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@holqa/local": "workspace:*",
    "@holqa/runtime-bun": "workspace:*",
    "@holqa/testing": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
