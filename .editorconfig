root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Source files follow the ESLint `style/eol-last: never` convention.
[*.{ts,tsx,mts,cts,js,mjs,cjs}]
insert_final_newline = false

[*.md]
trim_trailing_whitespace = false
